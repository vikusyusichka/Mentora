# ── Firebase (клієнт) ─────────────────────────────────────
# Для локальної розробки з емуляторами лишай demo-значення (проєкт demo-*
# ніколи не звертається до продакшну). Для реального проєкту підстав значення
# з Firebase Console → Project settings → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-mentora.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-mentora
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-mentora.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# true → клієнт під'єднується до Firebase Emulator Suite (локальна розробка)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# ── Firebase Admin (сервер) ───────────────────────────────
# Емулятори: наступні хости вмикають auto-connect Admin SDK.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FIREBASE_PROJECT_ID=demo-mentora

# Продакшн: JSON сервісного акаунта одним рядком (НЕ комітити).
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account", ...}

# ── Платежі: Stripe Connect (Блок B.3) ────────────────────
# Тестові ключі видає Stripe Dashboard → Developers → API keys.
# Секретний ключ платформи. НЕ NEXT_PUBLIC_ — він не має потрапляти в браузер.
STRIPE_SECRET_KEY=sk_test_...

# Секрет вебхука: Stripe Dashboard → Developers → Webhooks → endpoint
# https://<домен>/api/payments/webhook, події checkout.session.*, charge.refunded.
# Локально видається командою `stripe listen --forward-to localhost:3000/api/payments/webhook`.
# Без нього неможливо перевірити, що вебхук справді від Stripe.
STRIPE_WEBHOOK_SECRET=whsec_...

# Базовий URL сайту для canonical/og-посилань (на Vercel визначається сам).
# NEXT_PUBLIC_SITE_URL=https://mentora-q67k.vercel.app
