rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    // ── users ──────────────────────────────────────────────
    // Профіль акаунта. Роль обирається при онбордингу (create),
    // але ПІСЛЯ створення не може бути змінена з клієнта.
    // Джерело істини для авторизації — custom claim (ставить Cloud Function).
    match /users/{uid} {
      allow read: if isSelf(uid);

      allow create: if isSelf(uid)
        && request.resource.data.role in ['tutor', 'student', 'parent']
        && request.resource.data.keys().hasOnly(
             ['role', 'displayName', 'email', 'photoURL', 'createdAt']
           );

      allow update: if isSelf(uid)
        && request.resource.data.role == resource.data.role; // роль незмінна з клієнта

      allow delete: if false;
    }

    // ── tutorProfiles ──────────────────────────────────────
    // Публічна вітрина маркетплейсу.
    match /tutorProfiles/{tutorId} {

      // Поля, які має право писати лише сервер (Cloud Functions через Admin SDK):
      // рейтинг рахує тригер відгуків, payoutAccountId ставить платіжний онбординг.
      function serverFieldsUnchanged() {
        return request.resource.data.ratingAvg == resource.data.ratingAvg
          && request.resource.data.ratingCount == resource.data.ratingCount
          && request.resource.data.get('payoutAccountId', null)
             == resource.data.get('payoutAccountId', null)
          && request.resource.data.get('payoutProvider', null)
             == resource.data.get('payoutProvider', null)
          && request.resource.data.get('payoutsEnabled', null)
             == resource.data.get('payoutsEnabled', null);
      }

      function validProfile() {
        return request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 2
          && request.resource.data.bio is string
          && request.resource.data.languages is list
          && request.resource.data.languages.size() > 0
          && request.resource.data.levelsTaught is list
          && request.resource.data.levelsTaught.size() > 0
          && request.resource.data.pricePerLesson is number
          && request.resource.data.pricePerLesson > 0
          && request.resource.data.format in ['online', 'offline', 'both']
          && request.resource.data.isPublished is bool
          && validFilterTags();
      }

      // filterTags — денормалізація мова×рівень×формат під фільтри каталогу
      // (див. lib/catalog.ts). Поле пише клієнт, тож обмежуємо його розмір:
      // інакше репетитор міг би напхати тегів і потрапляти в кожну видачу,
      // а заразом роздути документ і його індексні записи.
      // Стеля 400 із запасом: максимум за формою — 8·7·3−1 = 167.
      function validFilterTags() {
        return request.resource.data.get('filterTags', []) is list
          && request.resource.data.get('filterTags', []).size() <= 400;
      }

      // Гість бачить лише опубліковані; власник бачить і свою чернетку.
      allow get: if resource.data.isPublished == true || isSelf(tutorId);
      allow list: if resource.data.isPublished == true || isSelf(tutorId);

      // Створити профіль може лише сам репетитор (роль з токена),
      // і лише з нульовим рейтингом — накрутити старт неможливо.
      allow create: if isSelf(tutorId)
        && hasRole('tutor')
        && validProfile()
        && request.resource.data.ratingAvg == 0
        && request.resource.data.ratingCount == 0
        && !request.resource.data.keys().hasAny(
             ['payoutAccountId', 'payoutProvider', 'payoutsEnabled']
           );

      allow update: if isSelf(tutorId)
        && hasRole('tutor')
        && validProfile()
        && serverFieldsUnchanged();

      allow delete: if false; // знімається з публікації через isPublished

      // ── розклад доступності (B.1) ────────────────────────
      // Читають і гості: з цих даних будується публічний календар вільних
      // слотів. Але лише для опублікованих профілів — інакше чернетка
      // видавала б себе через власний розклад.
      function tutorIsPublished() {
        return exists(/databases/$(database)/documents/tutorProfiles/$(tutorId))
          && get(/databases/$(database)/documents/tutorProfiles/$(tutorId))
             .data.isPublished == true;
      }

      function validAvailability() {
        return request.resource.data.weeklySlots is list
          && request.resource.data.weeklySlots.size() <= 200
          && request.resource.data.lessonDurationMin is number
          && request.resource.data.lessonDurationMin > 0
          && request.resource.data.lessonDurationMin <= 600
          && request.resource.data.bufferMin is number
          && request.resource.data.bufferMin >= 0
          && request.resource.data.bufferMin <= 240;
      }

      function validException() {
        return request.resource.data.blocked is list
          && request.resource.data.blocked.size() <= 100
          && request.resource.data.extra is list
          && request.resource.data.extra.size() <= 50;
      }

      match /availability/{docId} {
        allow read: if isSelf(tutorId) || tutorIsPublished();
        allow create, update: if isSelf(tutorId)
          && hasRole('tutor')
          && validAvailability();
        allow delete: if isSelf(tutorId) && hasRole('tutor');
      }

      // Публічна проєкція зайнятості (B.2): лише факт «слот зайнято»,
      // без персональних даних. Пише виключно сервер через Admin SDK.
      match /busySlots/{slotId} {
        allow read: if isSelf(tutorId) || tutorIsPublished();
        allow write: if false;
      }

      // Ключ документа — дата YYYY-MM-DD у таймзоні репетитора.
      match /slotExceptions/{date} {
        allow read: if isSelf(tutorId) || tutorIsPublished();
        allow create, update: if isSelf(tutorId)
          && hasRole('tutor')
          && validException();
        // Видалення = «скасувати виняток», штатна дія.
        allow delete: if isSelf(tutorId) && hasRole('tutor');
      }
    }

    // ── bookings ───────────────────────────────────────────
    // Броню створює серверний роут через Admin SDK, тож клієнту запис
    // закритий повністю: ані статус, ані суми, ані комісія не мають
    // залежати від того, що надішле браузер.
    match /bookings/{bookingId} {
      function isParticipant() {
        return isSignedIn()
          && (resource.data.studentUserId == request.auth.uid
              || resource.data.tutorId == request.auth.uid);
      }

      allow get: if isParticipant();
      allow list: if isParticipant();
      allow write: if false;
    }

    // ── payments ───────────────────────────────────────────
    // Пише лише сервер (вебхук провайдера). Учасники бачать свій платіж —
    // це потрібно, щоб показати статус оплати в кабінеті.
    match /payments/{paymentId} {
      function isParticipant() {
        return isSignedIn()
          && (resource.data.studentUserId == request.auth.uid
              || resource.data.tutorId == request.auth.uid);
      }

      allow get: if isParticipant();
      allow list: if isParticipant();
      allow write: if false;
    }

    // Решта колекцій закриті за замовчуванням — правила додаються по блоках плану.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
